SELECT C.Gender as Gender, sum(s.OrderQuantity * p.ProductPrice) as Total_Sales
FROM `prime-sunset-508012-u9.my_project.master_sales` s
join `prime-sunset-508012-u9.my_project.adv_products` P
on s.ProductKey = p.ProductKey

join `prime-sunset-508012-u9.my_project.adv_customers` C
on s.CustomerKey = c.CustomerKey
Group By Gender
